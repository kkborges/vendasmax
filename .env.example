# Database
DATABASE_URL=postgresql://vendasmax:vendasmax123@localhost:5432/vendasmax

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Backend API
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001

# Admin Web
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=VendasMax Admin

# Client App
VITE_CLIENT_API_URL=http://localhost:3001
VITE_CLIENT_APP_NAME=VendasMax Vendas

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your_mercado_pago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercado_pago_public_key

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@vendasmax.com.br
SENDGRID_FROM_NAME=VendasMax

# SMS/WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+5511999999999
TWILIO_WHATSAPP_NUMBER=whatsapp:+5511999999999

# AWS S3 (para armazenamento de imagens)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=vendasmax-products

# Notificações
NOTIFICATION_EMAIL=admin@vendasmax.com.br
NOTIFICATION_PHONE=+5511999999999
NOTIFICATION_WHATSAPP=+5511999999999

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ML/Analytics
ENABLE_ML_SUGGESTIONS=true
ML_MIN_SAMPLES=30
ML_PREDICTION_DAYS=30

# Offline Sync
OFFLINE_SYNC_INTERVAL_MS=60000
OFFLINE_MAX_RETRIES=5

# Stock Alerts
STOCK_ALERT_DAYS_BEFORE_EXPIRY=3
STOCK_ALERT_CHECK_INTERVAL_HOURS=6

# Payment Retry
PAYMENT_MAX_RETRIES=3
PAYMENT_RETRY_DELAY_MS=2000
